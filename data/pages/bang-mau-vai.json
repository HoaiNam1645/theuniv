er;\n  transition:background .2s,transform .2s;\n  z-index:100000;\n}\n\n.pcf-lb-close{\n  top:20px;\n  right:20px;\n  width:44px;\n  height:44px;\n  border-radius:50%;\n  font-size:22px;\n}\n\n.pcf-lb-close:hover{\n  background:rgba(255,255,255,.22);\n  transform:scale(1.1);\n}\n\n.pcf-lb-nav{\n  top:50%;\n  transform:translateY(-50%);\n  width:48px;\n  height:48px;\n  border-radius:50%;\n  font-size:22px;\n}\n\n.pcf-lb-nav:hover{\n  background:rgba(255,255,255,.22);\n  transform:translateY(-50%) scale(1.1);\n}\n\n.pcf-lb-prev{\n  left:16px;\n}\n\n.pcf-lb-next{\n  right:16px;\n}\n\n.pcf-lb-caption{\n  position:fixed;\n  bottom:24px;\n  left:50%;\n  transform:translateX(-50%);\n  background:rgba(0,0,0,.6);\n  backdrop-filter:blur(10px);\n  color:#fff;\n  font-size:13px;\n  font-weight:600;\n  padding:8px 20px;\n  border-radius:20px;\n  white-space:nowrap;\n}\n\n/* CTA */\n.pcf-cta{\n  margin-top:48px;\n  background:linear-gradient(135deg,#1a1208 0%,#2d1f0e 50%,#1a1a1a 100%);\n  border-radius:20px;\n  padding:36px 28px;\n  text-align:center;\n  color:#fff;\n  position:relative;\n  overflow:hidden;\n}\n\n.pcf-cta::before{\n  content:'';\n  position:absolute;\n  inset:0;\n  background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E\");\n  opacity:.05;\n  pointer-events:none;\n}\n\n.pcf-cta::after{\n  content:'';\n  position:absolute;\n  top:-60px;\n  right:-60px;\n  width:220px;\n  height:220px;\n  background:radial-gradient(circle,rgba(176,125,74,.28),transparent 70%);\n  border-radius:50%;\n  pointer-events:none;\n}\n\n.pcf-cta-inner{\n  position:relative;\n  z-index:1;\n}\n\n.pcf-cta-title{\n  font-size:clamp(18px,3vw,24px);\n  font-weight:800;\n  margin-bottom:8px;\n}\n\n.pcf-cta-sub{\n  font-size:13px;\n  color:rgba(255,255,255,.6);\n  margin-bottom:22px;\n}\n\n.pcf-cta-btns{\n  display:flex;\n  gap:12px;\n  justify-content:center;\n  flex-wrap:wrap;\n}\n\n.pcf-cta-btn{\n  padding:12px 24px;\n  border-radius:12px;\n  font-size:13px;\n  font-weight:700;\n  cursor:pointer;\n  border:none;\n  transition:all .25s;\n  text-decoration:none;\n  display:inline-flex;\n  align-items:center;\n  gap:7px;\n}\n\n.pcf-cta-btn.primary{\n  background:linear-gradient(135deg,#b07d4a,#c9944e);\n  color:#fff;\n  box-shadow:0 4px 16px rgba(176,125,74,.4);\n}\n\n.pcf-cta-btn.primary:hover{\n  transform:translateY(-2px);\n  box-shadow:0 8px 24px rgba(176,125,74,.5);\n}\n\n.pcf-cta-btn.secondary{\n  background:rgba(255,255,255,.1);\n  color:#fff;\n  border:1px solid rgba(255,255,255,.2);\n}\n\n.pcf-cta-btn.secondary:hover{\n  background:rgba(255,255,255,.18);\n}\n\n/* RESPONSIVE */\n@media(max-width:600px){\n  .pcf-hero{\n    padding:48px 16px 40px;\n    border-radius:0 0 20px 20px;\n  }\n\n  .pcf-inner{\n    padding:0 12px 48px;\n  }\n\n  .pcf-grid{\n    grid-template-columns:1fr 1fr;\n    gap:14px;\n  }\n\n  .pcf-card-body{\n    padding:12px 12px 14px;\n    gap:8px;\n  }\n\n  .pcf-card-name{\n    font-size:13px;\n  }\n\n  .pcf-drive-btn{\n    font-size:12px;\n    padding:10px 12px;\n  }\n\n  .pcf-tabs{\n    gap:4px;\n    padding:6px;\n    margin:16px 0 24px;\n  }\n\n  .pcf-tab{\n    padding:7px 12px;\n    font-size:12px;\n  }\n\n  .pcf-stats{\n    gap:20px;\n  }\n\n  .pcf-lb-nav{\n    width:var(--uni-tap);\n    height:var(--uni-tap);\n    font-size:18px;\n  }\n\n  .pcf-lb-prev{\n    left:8px;\n  }\n\n  .pcf-lb-next{\n    right:8px;\n  }\n}\n\n@media(max-width:380px){\n  .pcf-grid{\n    grid-template-columns:1fr;\n  }\n}\n\n/* Lưới do script dựng sau khi trang hydrate: tới lúc đó giữ chỗ một màn hình để khối CTA bên\n   dưới không hiện ra rồi bị đẩy đi (layout shift). */\n.pcf-grid-shell:not(:has(.pcf-card)){\n  min-height:100vh;\n}\n\n/* Màn chạm (cùng mốc với site-layout.css): tab và nút cao tối thiểu --uni-tap. */\n@media(max-width:1024px),(hover:none){\n  .pcf-tab,\n  .pcf-drive-btn,\n  .pcf-cta-btn{\n    min-height:var(--uni-tap);\n  }\n}\n</style>\n<div class=\"pcf-wrap\" id=\"pcfFabricWrap\">\n<div class=\"pcf-hero\">\n<div class=\"pcf-blob b1\">&nbsp;</div>\n<div class=\"pcf-blob b2\">&nbsp;</div>\n<div class=\"pcf-blob b3\">&nbsp;</div>\n<div class=\"pcf-particles\" id=\"pcfParticles\">&nbsp;</div>\n<div class=\"pcf-hero-inner\">\n<div class=\"pcf-label\">THE UNI</div>\n<h1 class=\"pcf-title\">Bảng Màu <span>Vải</span></h1>\n<p class=\"pcf-sub\">Xem ảnh màu thực tế từng chất liệu — chọn đúng vải, mặc đẹp hơn</p>\n<div class=\"pcf-stats\">\n<div class=\"pcf-stat\"><span class=\"pcf-stat-num\">14</span>\n<div class=\"pcf-stat-label\">Bảng màu</div></div>\n<div class=\"pcf-stat-divider\">&nbsp;</div>\n<div class=\"pcf-stat\"><span class=\"pcf-stat-num\">7</span>\n<div class=\"pcf-stat-label\">Dòng sản phẩm</div></div>\n<div class=\"pcf-stat-divider\">&nbsp;</div>\n<div class=\"pcf-stat\"><span class=\"pcf-stat-num\">100+</span>\n<div class=\"pcf-stat-label\">Màu sắc</div></div></div></div></div>\n<div class=\"pcf-inner\">\n<div class=\"pcf-tabs\" id=\"pcfTabs\"><button class=\"pcf-tab is-active\" data-tab=\"all\" type=\"button\">Tất cả</button><button class=\"pcf-tab\" data-tab=\"thun\" type=\"button\">Áo Thun</button><button class=\"pcf-tab\" data-tab=\"polo\" type=\"button\">Áo Polo</button><button class=\"pcf-tab\" data-tab=\"thethao\" type=\"button\">Áo Thể Thao</button><button class=\"pcf-tab\" data-tab=\"khoac\" type=\"button\">Áo Khoác</button><button class=\"pcf-tab\" data-tab=\"somi\" type=\"button\">Áo Sơ Mi</button><button class=\"pcf-tab\" data-tab=\"non\" type=\"button\">Nón</button><button class=\"pcf-tab\" data-tab=\"tapde\" type=\"button\">Tạp Dề</button></div>\n<div class=\"pcf-grid-shell\" id=\"pcfGridShell\">\n<div class=\"pcf-grid\" id=\"pcfGrid\">&nbsp;</div></div>\n<div class=\"pcf-cta\">\n<div class=\"pcf-cta-inner\">\n<div class=\"pcf-cta-title\">Chưa biết chọn vải nào?</div>\n<div class=\"pcf-cta-sub\">Gửi nhu cầu &amp; số lượng — THEUNI tư vấn vải phù hợp ngân sách ngay</div>\n<div class=\"pcf-cta-btns\"><a class=\"pcf-cta-btn primary\" href=\"https://zalo.me/0399259155\" rel=\"noopener\" target=\"_blank\">💬 Chat Zalo miễn phí</a> <a class=\"pcf-cta-btn secondary\" href=\"/cac-loai-vai-ao-dong-phuc\" rel=\"noopener\" target=\"_blank\">Tìm hiểu đặc tính vải →</a></div></div></div></div>\n<div class=\"pcf-lb\" id=\"pcfLb\"><button class=\"pcf-lb-close\" id=\"pcfLbClose\" type=\"button\">✕</button><button class=\"pcf-lb-nav pcf-lb-prev\" id=\"pcfLbPrev\" type=\"button\">‹</button>\n<div class=\"pcf-lb-img-wrap\"><img alt=\"\" class=\"pcf-lb-img\" id=\"pcfLbImg\" src=\"\" /></div><button class=\"pcf-lb-nav pcf-lb-next\" id=\"pcfLbNext\" type=\"button\">›</button>\n<div class=\"pcf-lb-caption\" id=\"pcfLbCaption\">&nbsp;</div></div></div><script>\n(function(){\n  const wrap = document.getElementById('pcfFabricWrap');\n  if(!wrap || wrap.dataset.ready === '1') return;\n  wrap.dataset.ready = '1';\n\n  const VAI = [\n    {\n      name:\"Cotton 4c 100% 190gsm\",\n      tab:\"thun\",\n      badge:\"Áo Thun\",\n      tags:[\"Thoáng mát\",\"Cotton 100%\",\"190gsm\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-vai-100-cotton-190gsm-12-5-25.jpg?v=1747042669683\",\n      drive:\"https://drive.google.com/drive/folders/1Vk5rmCh8R306TWbPKeGqRGq4Mir0Pc3_?usp=sharing\"\n    },\n    {\n      name:\"Cotton 2c 100% Premium\",\n      tab:\"thun\",\n      badge:\"Áo Thun\",\n      tags:[\"Mềm mịn\",\"Cotton 100%\",\"Premium\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-vai-thun-100-cotton-2c-9323.jpg?v=1681189544640\",\n      drive:\"https://drive.google.com/drive/folders/1WCzf7csRuYt-UUs_HDLz6F7jumnU5oT4?usp=sharing\"\n    },\n    {\n      name:\"Cotton 4c 100% Premium 240gsm\",\n      tab:\"thun\",\n      badge:\"Áo Thun\",\n      tags:[\"Dày dặn\",\"Cotton 100%\",\"240gsm\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-ao-thun-cotton-100-premium-b2bbf765-ae88-436e-a955-497b6e9d0f1c.jpg?v=1719984699232\",\n      drive:\"https://drive.google.com/drive/folders/1H-WCaCyrglb2AXQeAm5o0R7HLin8jBHE?usp=sharing\"\n    },\n    {\n      name:\"Cá sấu 100% Cotton\",\n      tab:\"polo\",\n      badge:\"Áo Polo\",\n      tags:[\"Cổ bẻ\",\"Cotton 100%\",\"Form đứng\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-vai-ca-sau-100-cotton-2992022.jpg?v=1681189543747\",\n      drive:\"https://drive.google.com/drive/folders/1fjSoPlCZSYnWiHaPu1Ry3SqkFAV_Kmw0?usp=sharing\"\n    },\n    {\n      name:\"Cá sấu 65% Cao cấp\",\n      tab:\"polo\",\n      badge:\"Áo Polo\",\n      tags:[\"Cao cấp\",\"65% Cotton\",\"Bền màu\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-vai-ca-sau-65-cao-cap-dong-phuc-THEUNI-clothing.jpg?v=1759400833741\",\n      drive:\"https://drive.google.com/drive/folders/1-056yzgkjfCu-8cQI0JQO-o7Wcs52D2y?usp=sharing\"\n    },\n    {\n      name:\"Cá sấu Poly\",\n      tab:\"polo\",\n      badge:\"Áo Polo\",\n      tags:[\"Nhẹ\",\"Poly\",\"Dễ giặt\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-ca-sau-poly-27-9-2023.jpg?v=1695713167647\",\n      drive:\"https://drive.google.com/drive/folders/1Ni3Ic5ma1ZdZKltvTWmY99kmZX_mbs3r?usp=sharing\"\n    },\n    {\n      name:\"Thun Mè\",\n      tab:\"thethao\",\n      badge:\"Thể Thao\",\n      tags:[\"Thoát ẩm\",\"Mè lưới\",\"Năng động\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang_mau_vai_me_18.6.2026.jpg?v=1782183939220\",\n      drive:\"https://drive.google.com/drive/folders/15oj1c1ZFWX8T9OrAlew9a210GY1nZ22v?usp=drive_link\"\n    },\n    {\n      name:\"Thun Lạnh\",\n      tab:\"thethao\",\n      badge:\"Thể Thao\",\n      tags:[\"Mát lạnh\",\"Co giãn 4 chiều\",\"Wicking\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-thun-lanh-giam-size-20.jpg?v=1773996145420\",\n      drive:\"https://drive.google.com/drive/folders/1PEPlQrCdJ45_PPRy5WYMIz0cF4Sx0CRT?usp=sharing\"\n    },\n    {\n      name:\"Cotton Da Cá\",\n      tab:\"khoac\",\n      badge:\"Áo Khoác\",\n      tags:[\"Texture đẹp\",\"Giữ form\",\"Da cá\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-vai-cotton-da-ca-11-4-25.jpg?v=1744358108345\",\n      drive:\"https://drive.google.com/drive/folders/1UwOuN6CwsZBywuS0Mb04eR5uKh83MZvF?usp=sharing\"\n    },\n    {\n      name:\"Chân Cua\",\n      tab:\"khoac\",\n      badge:\"Áo Khoác\",\n      tags:[\"Ấm\",\"Dệt đặc\",\"Nỉ mặt trong\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-vai-chan-cua-THEUNI-clothing-2323.jpg?v=1681189544097\",\n      drive:\"https://drive.google.com/drive/folders/1jTtAh4lvEalOD5VWkUutWo0RQeOvQlCB?usp=sharing\"\n    },\n    {\n      name:\"Bóng Chiếu\",\n      tab:\"khoac\",\n      badge:\"Áo Khoác\",\n      tags:[\"Vải phối\",\"Windproof\",\"Nhẹ\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-vai-bong-chieu.jpg?v=1729658990879\",\n      drive:\"https://drive.google.com/drive/folders/1-cA8gSPo-GYIWLvipy1waoSl4Cvqvlo_?usp=sharing\"\n    },\n    {\n      name:\"Kate Oxford\",\n      tab:\"somi\",\n      badge:\"Sơ Mi\",\n      tags:[\"Lịch sự\",\"Oxford\",\"Chống nhăn\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang-mau-vai-kate-oxford-20-2-25.jpg?v=1740023208504\",\n      drive:\"https://drive.google.com/drive/folders/1AEU-rq8S75LTxBKq4g9BQqTINRDidLGg?usp=sharing\"\n    },\n    {\n      name:\"Bảng màu Nón\",\n      tab:\"non\",\n      badge:\"Nón\",\n      tags:[\"Nón đồng phục\",\"Màu thực tế\",\"May/In theo yêu cầu\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang_mau_non_kaki_18.06.2026.jpg?v=1782183939407\",\n      drive:\"https://drive.google.com/drive/folders/1rx58xnjJBqGNVo8c_VjJzmcSBFCMbJWx\"\n    },\n    {\n      name:\"Bảng màu Tạp Dề\",\n      tab:\"tapde\",\n      badge:\"Tạp Dề\",\n      tags:[\"Tạp dề đồng phục\",\"Màu thực tế\",\"May/In theo yêu cầu\"],\n      img:\"https://bizweb.dktcdn.net/100/482/641/files/bang_mau_tap_de_kaki_cotton.jpg?v=1779349324737\",\n      drive:\"https://bizweb.dktcdn.net/100/482/641/files/bang_mau_tap_de_kaki_cotton.jpg?v=1779349324737\"\n    }\n  ];\n\n  const grid = document.getElementById('pcfGrid');\n  const shell = document.getElementById('pcfGridShell');\n  const tabs = Array.from(document.querySelectorAll('.pcf-tab'));\n  const particles = document.getElementById('pcfParticles');\n\n  const lb = document.getElementById('pcfLb');\n  const lbImg = document.getElementById('pcfLbImg');\n  const lbCap = document.getElementById('pcfLbCaption');\n  const lbClose = document.getElementById('pcfLbClose');\n  const lbPrev = document.getElementById('pcfLbPrev');\n  const lbNext = document.getElementById('pcfLbNext');\n\n  let currentTab = 'all';\n  let lbList = VAI.slice();\n  let lbIndex = 0;\n  let resizeTimer = null;\n\n  function esc(str){\n    return String(str).replace(/[&<>\"']/g,function(m){\n      return {\n        '&':'&amp;',\n        '<':'&lt;',\n        '>':'&gt;',\n        '\"':'&quot;',\n        \"'\":'&#039;'\n      }[m];\n    });\n  }\n\n  function cardHTML(item,index){\n    return `\n      <div class=\"pcf-card\" data-tab=\"${esc(item.tab)}\" data-index=\"${index}\">\n        <div class=\"pcf-img-wrap\" data-action=\"open-lightbox\">\n          <img src=\"${esc(item.img)}\" alt=\"${esc(item.name)}\" loading=\"eager\">\n          <div class=\"pcf-zoom-hint\">\n            <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n              <path d=\"m21 21-4.35-4.35\"></path>\n              <path d=\"M11 8v6M8 11h6\"></path>\n            </svg>\n          </div>\n          <span class=\"pcf-badge\">${esc(item.badge)}</span>\n        </div>\n\n        <div class=\"pcf-card-body\">\n          <div class=\"pcf-img-hint\">🔍 Nhấn vào ảnh để xem màu rõ hơn</div>\n          <div class=\"pcf-card-name\">${esc(item.name)}</div>\n\n          <div class=\"pcf-tags\">\n            ${item.tags.map(function(tag){\n              return `<span class=\"pcf-tag\">${esc(tag)}</span>`;\n            }).join('')}\n          </div>\n\n          <a class=\"pcf-drive-btn\" href=\"${esc(item.drive)}\" target=\"_blank\" rel=\"noopener\">\n            Xem màu thực tế →\n          </a>\n        </div>\n      </div>\n    `;\n  }\n\n  function renderOnce(){\n    grid.innerHTML = VAI.map(cardHTML).join('');\n  }\n\n  function getCurrentList(){\n    return currentTab === 'all'\n      ? VAI.slice()\n      : VAI.filter(function(item){ return item.tab === currentTab; });\n  }\n\n  function lockGridHeight(){\n    if(!grid || !shell) return;\n\n    const probe = grid.cloneNode(false);\n    probe.removeAttribute('id');\n    probe.style.position = 'absolute';\n    probe.style.visibility = 'hidden';\n    probe.style.pointerEvents = 'none';\n    probe.style.left = '-99999px';\n    probe.style.top = '0';\n    probe.style.width = grid.getBoundingClientRect().width + 'px';\n    probe.innerHTML = VAI.map(cardHTML).join('');\n\n    shell.appendChild(probe);\n    const height = Math.ceil(probe.getBoundingClientRect().height);\n    probe.remove();\n\n    if(height > 0){\n      shell.style.minHeight = height + 'px';\n    }\n  }\n\n  function filterCards(tab){\n    const y = window.pageYOffset;\n    currentTab = tab;\n    lbList = getCurrentList();\n\n    grid.querySelectorAll('.pcf-card').forEach(function(card){\n      const show = tab === 'all' || card.dataset.tab === tab;\n      card.classList.toggle('is-hidden',!show);\n    });\n\n    requestAnimationFrame(function(){\n      window.scrollTo(0,y);\n    });\n  }\n\n  function openLightboxByGlobalIndex(globalIndex){\n    lbList = getCurrentList();\n\n    const item = VAI[globalIndex];\n    if(!item) return;\n\n    const foundIndex = lbList.findIndex(function(v){\n      return v.name === item.name;\n    });\n\n    lbIndex = foundIndex >= 0 ? foundIndex : 0;\n    updateLightbox();\n\n    lb.classList.add('is-open');\n    document.body.style.overflow = 'hidden';\n  }\n\n  function updateLightbox(){\n    const item = lbList[lbIndex];\n    if(!item) return;\n\n    lbImg.style.opacity = '0';\n\n    setTimeout(function(){\n      lbImg.src = item.img;\n      lbImg.alt = item.name;\n      lbCap.textContent = item.name;\n      lbImg.style.opacity = '1';\n    },90);\n  }\n\n  function closeLightbox(){\n    lb.classList.remove('is-open');\n    document.body.style.overflow = '';\n  }\n\n  function navLightbox(dir){\n    if(!lbList.length) return;\n    lbIndex = (lbIndex + dir + lbList.length) % lbList.length;\n    updateLightbox();\n  }\n\n  function buildParticles(){\n    if(!particles) return;\n    particles.innerHTML = '';\n\n    for(let i = 0; i < 18; i++){\n      const p = document.createElement('div');\n      const size = Math.random() * 4 + 2;\n\n      p.className = 'pcf-particle';\n      p.style.width = size + 'px';\n      p.style.height = size + 'px';\n      p.style.left = Math.random() * 100 + '%';\n      p.style.bottom = Math.random() * 30 + '%';\n      p.style.animationDuration = Math.random() * 6 + 5 + 's';\n      p.style.animationDelay = Math.random() * 6 + 's';\n      p.style.opacity = Math.random() * .5 + .2;\n\n      particles.appendChild(p);\n    }\n  }\n\n  renderOnce();\n  buildParticles();\n\n  requestAnimationFrame(function(){\n    lockGridHeight();\n    setTimeout(lockGridHeight,300);\n    setTimeout(lockGridHeight,900);\n  });\n\n  tabs.forEach(function(tabBtn){\n    tabBtn.addEventListener('click',function(){\n      const tab = tabBtn.dataset.tab;\n      if(!tab || tab === currentTab) return;\n\n      tabs.forEach(function(t){\n        t.classList.remove('is-active');\n      });\n\n      tabBtn.classList.add('is-active');\n      filterCards(tab);\n    });\n  });\n\n  grid.addEventListener('click',function(e){\n    const imgWrap = e.target.closest('[data-action=\"open-lightbox\"]');\n    if(!imgWrap) return;\n\n    const card = imgWrap.closest('.pcf-card');\n    if(!card) return;\n\n    const globalIndex = parseInt(card.dataset.index,10);\n    openLightboxByGlobalIndex(globalIndex);\n  });\n\n  lbClose.addEventListener('click',closeLightbox);\n  lbPrev.addEventListener('click',function(){ navLightbox(-1); });\n  lbNext.addEventListener('click',function(){ navLightbox(1); });\n\n  lb.addEventListener('click',function(e){\n    if(e.target === lb){\n      closeLightbox();\n    }\n  });\n\n  document.addEventListener('keydown',function(e){\n    if(!lb.classList.contains('is-open')) return;\n\n    if(e.key === 'Escape') closeLightbox();\n    if(e.key === 'ArrowLeft') navLightbox(-1);\n    if(e.key === 'ArrowRight') navLightbox(1);\n  });\n\n  window.addEventListener('resize',function(){\n    clearTimeout(resizeTimer);\n    resizeTimer = setTimeout(function(){\n      lockGridHeight();\n      filterCards(currentTab);\n    },180);\n  });\n})();\n</script>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style=\"font-size:16px;margin-top: 15px;display: block;\">\n\t\t\t\t\t\t\t\t<p dir=\"ltr\" style=\"text-align: justify; margin-bottom: 5px;\"><strong>Thông tin liên hệ:</strong></p>\n\t\t\t\t\t\t\t\t<ul style=\"padding-left: 20px;\" dir=\"ltr\">\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Fanpage: <a style=\"color: #f4bd24;font-weight: 700;\" href=\"https://www.facebook.com/Shop.THEUNI.Clothing\" target=\"_blank\">THE UNI</a></li>\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Hotline: 028 6683 0386 - 039 9259 155</li>\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Email: theuniclothes@gmai.com&nbsp; |&nbsp; Liên hệ hợp tác: marketing@THEUNI.clothing</li>\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Cửa hàng: K249/83/4 Hà Huy Tập, Đà Nẵng (kiệt ô tô)</li>\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Xưởng Sản xuất: