n  pointer-events: none;\n  user-select: none;\n  animation: pwFloat 7s ease-in-out infinite;\n}\n.wrapper .pw-THEUNI:nth-child(1) { top:10%;  left:4%;  animation-delay:0s; }\n.wrapper .pw-THEUNI:nth-child(2) { top:55%;  left:1%;  font-size:38px; animation-delay:1.5s; }\n.wrapper .pw-THEUNI:nth-child(3) { top:8%;   right:5%; font-size:44px; animation-delay:.8s; }\n.wrapper .pw-THEUNI:nth-child(4) { top:60%;  right:3%; font-size:36px; animation-delay:2.2s; }\n.wrapper .pw-THEUNI:nth-child(5) { bottom:5%;left:44%; font-size:30px; animation-delay:1s; }\n@keyframes pwFloat {\n  0%,100% { transform: translateY(0) rotate(-5deg); }\n  50%     { transform: translateY(-14px) rotate(5deg); }\n}\n\n.wrapper .pw-hero-inner {\n  position: relative;\n  z-index: 2;\n  max-width: 560px;\n  margin: 0 auto;\n}\n\n.wrapper .pw-hero-label {\n  display: inline-block;\n  background: rgba(255,255,255,.15);\n  border: 1px solid rgba(255,255,255,.25);\n  color: #fff;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  padding: 5px 16px;\n  border-radius: 30px;\n  margin-bottom: 18px;\n}\n.wrapper .hero-banner h2 {\n  font-size: clamp(24px, 4.5vw, 40px);\n  font-weight: 900;\n  color: #fff;\n  line-height: 1.2;\n  margin: 0 0 10px;\n}\n.wrapper .hero-banner h2 em {\n  font-style: normal;\n  color: #7eb3ff;\n}\n.wrapper .pw-hero-sub {\n  font-size: 14px;\n  color: rgba(255,255,255,.65);\n  font-weight: 500;\n  margin: 0 0 22px;\n}\n.wrapper .pw-perks {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.wrapper .pw-perks span {\n  background: rgba(255,255,255,.1);\n  border: 1px solid rgba(255,255,255,.2);\n  color: rgba(255,255,255,.9);\n  font-size: 12px;\n  font-weight: 600;\n  padding: 6px 14px;\n  border-radius: 20px;\n}\n\n/* ── TABS STICKY — fill 100% ── */\n.wrapper .pw-tabs-wrap {\n  position: sticky;\n  top: 0;\n  z-index: 100;\n  background: #fff;\n  border-bottom: 1.5px solid #eaedf5;\n  box-shadow: 0 2px 16px rgba(26,31,54,.07);\n  margin: 0 -16px; /* bù padding của Sapo nếu có */\n  padding: 0 16px;\n}\n.wrapper .pw-tabs {\n  display: flex;\n  overflow-x: auto;\n  scrollbar-width: none;\n  padding: 10px 0;\n  gap: 8px;\n}\n.wrapper .pw-tabs::-webkit-scrollbar { display: none; }\n\n.wrapper .pw-tab {\n  flex-shrink: 0;\n  padding: 8px 20px;\n  font-size: 13px;\n  font-weight: 700;\n  cursor: pointer;\n  border: none;\n  border-radius: 30px;\n  white-space: nowrap;\n  background: #f4f6fb;\n  color: #555e7b;\n  transition: background .2s, color .2s, transform .15s;\n}\n.wrapper .pw-tab:hover  { background: #e8ecf8; color: #1a1f36; }\n.wrapper .pw-tab.active { background: #1a1f36; color: #fff; }\n.wrapper .pw-tab:active { transform: scale(.96); }\n\n/* ── ARTICLE CONTAINER — fill 100%, không max-width ── */\n.wrapper .article-container {\n  width: 100%;\n  padding: 28px 16px 48px;\n  background: #f4f6fb;\n  border-radius: 16px;\n  overflow: visible;\n  min-height: 580px;\n  margin-top: 16px;\n}\n\n.wrapper .pw-section { display: none; }\n.wrapper .pw-section.active { display: block; }\n\n/* ── GRID — fill 100% ── */\n.wrapper .pw-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 16px;\n  align-items: start;\n}\n\n/* ── CARD ── */\n.wrapper .pw-card {\n  background: #fff;\n  border-radius: 14px;\n  overflow: hidden;\n  border: 1.5px solid #eaedf5;\n  cursor: pointer;\n  transition: border-color .2s, box-shadow .2s, transform .2s;\n  display: flex;\n  flex-direction: column;\n}\n.wrapper .pw-card:hover {\n  border-color: #3b5bdb;\n  box-shadow: 0 10px 32px rgba(59,91,219,.14);\n  transform: translateY(-4px);\n}\n.wrapper .pw-card-img-wrap {\n  overflow: hidden;\n  background: #f4f6fb;\n}\n.wrapper .pw-card-img {\n  width: 100%;\n  height: 220px;\n  object-fit: cover;\n  object-position: top;\n  display: block;\n  transition: transform .35s ease;\n}\n.wrapper .pw-card:hover .pw-card-img { transform: scale(1.05); }\n\n.wrapper .pw-card-body {\n  padding: 12px 14px 14px;\n  border-top: 1px solid #f0f2f8;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.wrapper .pw-card-name {\n  font-size: 13px;\n  font-weight: 700;\n  color: #1a1f36;\n  margin: 0;\n}\n.wrapper .pw-card-hint {\n  font-size: 11px;\n  color: #3b5bdb;\n  font-weight: 600;\n}\n\n/* ── LIGHTBOX ── */\n.wrapper .pw-lightbox {\n  display: none;\n  position: fixed;\n  inset: 0;\n  background: rgba(10,12,26,.92);\n  z-index: 9999;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n}\n.wrapper .pw-lightbox.open { display: flex; }\n.wrapper .pw-lb-inner {\n  position: relative;\n  max-width: 680px;\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.wrapper .pw-lb-inner img {\n  max-width: 100%;\n  max-height: 88vh;\n  border-radius: 12px;\n  object-fit: contain;\n  object-position: top;\n  display: block;\n  box-shadow: 0 24px 64px rgba(0,0,0,.6);\n}\n.wrapper .pw-lb-close {\n  position: absolute;\n  top: -14px; right: -14px;\n  width: 36px; height: 36px;\n  background: #fff;\n  border: none; border-radius: 50%;\n  font-size: 16px; font-weight: 900;\n  cursor: pointer; color: #1a1f36;\n  display: flex; align-items: center; justify-content: center;\n  box-shadow: 0 2px 12px rgba(0,0,0,.25);\n  transition: background .2s, transform .2s;\n}\n.wrapper .pw-lb-close:hover { background: #e8ecf8; transform: scale(1.1); }\n.wrapper .pw-lb-nav {\n  position: absolute;\n  top: 50%; transform: translateY(-50%);\n  background: rgba(255,255,255,.12);\n  border: 1px solid rgba(255,255,255,.22);\n  color: #fff; font-size: 24px;\n  width: 42px; height: 42px;\n  border-radius: 50%; cursor: pointer;\n  display: flex; align-items: center; justify-content: center;\n  transition: background .2s;\n}\n.wrapper .pw-lb-nav:hover { background: rgba(255,255,255,.26); }\n.wrapper .pw-lb-prev { left: -54px; }\n.wrapper .pw-lb-next { right: -54px; }\n.wrapper .pw-lb-counter {\n  position: absolute; bottom: -28px;\n  left: 50%; transform: translateX(-50%);\n  color: rgba(255,255,255,.45);\n  font-size: 12px; font-weight: 600; white-space: nowrap;\n}\n\n/* ── CTA STICKY ── */\n.wrapper .pw-cta-sticky {\n  position: fixed;\n  bottom: 22px; right: 16px;\n  display: flex; flex-direction: column; gap: 10px;\n  z-index: 998;\n}\n.wrapper .pw-cta-btn {\n  display: flex; align-items: center; gap: 8px;\n  padding: 10px 18px; border-radius: 30px;\n  font-size: 13px; font-weight: 700;\n  text-decoration: none; color: #fff;\n  box-shadow: 0 4px 16px rgba(0,0,0,.18);\n  transition: transform .2s, box-shadow .2s;\n}\n.wrapper .pw-cta-btn:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(0,0,0,.22);\n}\n.wrapper .pw-cta-zalo { background: #0068ff; }\n.wrapper .pw-cta-mess { background: #1a1f36; }\n\n/* ── RESPONSIVE ── */\n@media (max-width: 768px) {\n  .wrapper .hero-banner { padding: 40px 16px 56px; border-radius: 0 0 24px 24px; }\n  .wrapper .pw-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }\n  .wrapper .article-container { padding: 20px 0 36px; border-radius: 12px; }\n}\n@media (max-width: 480px) {\n  .wrapper .pw-card-img { height: 160px; }\n  .wrapper .pw-lb-prev { left: 4px; }\n  .wrapper .pw-lb-next { right: 4px; }\n}\n</style>\n\n<div class=\"wrapper\">\n\n  <!-- HERO -->\n  <section class=\"hero-banner\">\n    <span class=\"pw-THEUNI\">🥔</span>\n    <span class=\"pw-THEUNI\">🥔</span>\n    <span class=\"pw-THEUNI\">🥔</span>\n    <span class=\"pw-THEUNI\">🥔</span>\n    <span class=\"pw-THEUNI\">🥔</span>\n    <div class=\"pw-hero-inner\">\n      <div class=\"pw-hero-label\">🎒 Học sinh · Sinh viên</div>\n      <h2>Bảng Giá<br><em>Áo Lớp</em> THE UNI</h2>\n      <p class=\"pw-hero-sub\">Thiết kế riêng · In theo yêu cầu · Giao toàn quốc</p>\n      <div class=\"pw-perks\">\n        <span>✅ Giá tốt cho HS/SV</span>\n        <span>✅ In theo yêu cầu</span>\n        <span>✅ Giao toàn quốc</span>\n        <span>✅ Tư vấn miễn phí</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- TABS -->\n  <div class=\"pw-tabs-wrap\">\n    <div class=\"pw-tabs\" id=\"pwTabs\">\n      <button class=\"pw-tab active\" data-tab=\"thun\"    type=\"button\">👕 Áo Thun</button>\n      <button class=\"pw-tab\"        data-tab=\"polo\"    type=\"button\">🏷️ Áo Polo</button>\n      <button class=\"pw-tab\"        data-tab=\"somi\"    type=\"button\">👔 Áo Sơ Mi</button>\n      <button class=\"pw-tab\"        data-tab=\"thethao\" type=\"button\">⚽ Thể Thao</button>\n      <button class=\"pw-tab\"        data-tab=\"dailay\"  type=\"button\">🧥 Áo Dài Tay</button>\n    </div>\n  </div>\n\n  <!-- GRID CONTENT -->\n  <div class=\"article-container\">\n    <div class=\"pw-section active\" id=\"tab-thun\">\n      <div class=\"pw-grid\" id=\"grid-thun\"></div>\n    </div>\n    <div class=\"pw-section\" id=\"tab-polo\">\n      <div class=\"pw-grid\" id=\"grid-polo\"></div>\n    </div>\n    <div class=\"pw-section\" id=\"tab-somi\">\n      <div class=\"pw-grid\" id=\"grid-somi\"></div>\n    </div>\n    <div class=\"pw-section\" id=\"tab-thethao\">\n      <div class=\"pw-grid\" id=\"grid-thethao\"></div>\n    </div>\n    <div class=\"pw-section\" id=\"tab-dailay\">\n      <div class=\"pw-grid\" id=\"grid-dailay\"></div>\n    </div>\n  </div>\n\n  <!-- LIGHTBOX -->\n  <div class=\"pw-lightbox\" id=\"pwLightbox\">\n    <div class=\"pw-lb-inner\">\n      <button class=\"pw-lb-close\" id=\"lbClose\" type=\"button\">✕</button>\n      <button class=\"pw-lb-nav pw-lb-prev\" id=\"lbPrev\" type=\"button\">‹</button>\n      <img id=\"lbImg\" src=\"\" alt=\"\">\n      <button class=\"pw-lb-nav pw-lb-next\" id=\"lbNext\" type=\"button\">›</button>\n      <div class=\"pw-lb-counter\" id=\"lbCounter\"></div>\n    </div>\n  </div>\n\n  <!-- CTA STICKY -->\n  <div class=\"pw-cta-sticky\">\n    <a class=\"pw-cta-btn pw-cta-zalo\" href=\"https://zalo.me/0399259155\" rel=\"noopener\" target=\"_blank\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\"><text dominant-baseline=\"middle\" fill=\"white\" font-size=\"14\" font-weight=\"900\" text-anchor=\"middle\" x=\"50%\" y=\"55%\">Z</text></svg>\n      Chat Zalo\n    </a>\n    <a class=\"pw-cta-btn pw-cta-mess\" href=\"https://m.me/Shop.THEUNI.Clothing/\" rel=\"noopener\" target=\"_blank\">\n      <svg fill=\"white\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.477 2 2 6.145 2 11.243c0 2.908 1.438 5.504 3.688 7.205V22l3.37-1.854A10.5 10.5 0 0012 20.486c5.523 0 10-4.145 10-9.243S17.523 2 12 2zm1.07 12.44l-2.55-2.72-4.98 2.72 5.48-5.82 2.61 2.72 4.92-2.72-5.48 5.82z\"/></svg>\n      Messenger\n    </a>\n  </div>\n\n</div><!-- /.wrapper -->\n\n<script>\n(function () {\n  var BASE = 'https://bizweb.dktcdn.net/100/482/641/files/';\n\n  var products = {\n    thun: [\n      { name: 'Áo Thun Cổ Tròn',    img: 'bang-gia-ao-lopco-tron-THEUNI-clothing-8-24.jpg?v=1724752096086' },\n      { name: 'Áo Thun Cool Collar', img: 'bang-gia-ao-thun-cool-collar.jpg?v=1733978261390' },\n      { name: 'Áo Thun Retro',       img: 'bang-gia-ao-lop-retro-THEUNI-clothing.jpg?v=1740384447047' },\n      { name: 'Áo Thun Raglan',      img: 'bang-gia-ao-lop-raglan-THEUNI-clothing-28-8-24.jpg?v=1724813378827' }\n    ],\n    polo: [\n      { name: 'Áo Polo Basic',       img: 'bang-gia-ao-lop-polo-basic-111125.jpg?v=1762781687953' },\n      { name: 'Áo Polo Cool Collar', img: 'bang-gia-ao-lop-polo-cool-collar.jpg?v=1733978274596' },\n      { name: 'Áo Polo Raglan',      img: 'bang-gia-ao-lop-polo-raglan-THEUNI-clothing-8-24.jpg?v=1724752365074' },\n      { name: 'Áo Polo Sporty Chic', img: 'bang-gia-ao-lop-sporty-chic-THEUNI-clothing-8-24.jpg?v=1724752383183' },\n      { name: 'Áo Polo Dynamix',     img: 'bang-gia-ao-lop-dynamix-polo-THEUNI-clothing-8-24.jpg?v=1724752402342' },\n      { name: 'Áo Polo Zippy',       img: 'bang-gia-ao-lop-zippy-polo-THEUNI-clothing-8-24.jpg?v=1724752432733' },\n      { name: 'Áo Polo Tie Line',    img: 'bang-gia-ao-lop-polo-tie-line-THEUNI-clothing.jpg?v=1724323463779' }\n    ],\n    somi: [\n      { name: 'Áo Sơ Mi',         img: 'bang-gia-ao-lop-somi-THEUNI-clothing-23-2-24.jpg?v=1708943542961' },\n      { name: 'Áo Sơ Mi Casual',  img: 'bang-gia-ao-lop-somi-casual-THEUNI-clothing-8-24.jpg?v=1724752461726' },\n      { name: 'Áo Sơ Mi Cổ Trụ', img: 'bang-gia-ao-lop-somi-co-tru-THEUNI-clothing.jpg?v=1724661882236' }\n    ],\n    thethao: [\n      { name: 'Áo Bóng Rổ',      img: 'bang-gia-ao-bong-ro-THEUNI-clothing-23-3-24.jpg?v=1711185971652' },\n      { name: 'Áo Bóng Bầu Dục', img: 'bang-gia-ao-lop-bong-bau-duc-THEUNI-clothing-28-10-24.jpg?v=1731142377131' },\n      { name: 'Áo Bóng Chày',    img: 'bang-gia-ao-lop-bong-chay-THEUNI-clothing-7-10-24.jpg?v=1729327752154' }\n    ],\n    dailay: [\n      { name: 'Áo Tay Dài Cozy Sleeve', img: 'bang-gia-ao-lop-tay-dai-cozy-sleeve.jpg?v=1733978296211' },\n      { name: 'Áo Sweater',             img: 'bang-gia-ao-lop-sweater-THEUNI-clothing-8-24.jpg?v=1724752550267' },\n      { name: 'Áo Sweater Zip',         img: 'bang-gia-ao-lop-sweater-zip-THEUNI-clothing-8-24.jpg?v=1724752571322' },\n      { name: 'Áo Cardigan',            img: 'bang-gia-ao-lop-cardigan-THEUNI-clothing-8-24.jpg?v=1724752589561' },\n      { name: 'Áo Hoodie',              img: 'bang-gia-ao-lop-hoodie-THEUNI-clothing-8-24.jpg?v=1724752622017' }\n    ]\n  };\n\n  var curGroup = [], curIdx = 0;\n\n  function openLb(imgs, i) {\n    curGroup = imgs; curIdx = i;\n    renderLb();\n    document.getElementById('pwLightbox').classList.add('open');\n    document.body.style.overflow = 'hidden';\n  }\n  function closeLb() {\n    document.getElementById('pwLightbox').classList.remove('open');\n    document.body.style.overflow = '';\n  }\n  function renderLb() {\n    document.getElementById('lbImg').src = BASE + curGroup[curIdx];\n    document.getElementById('lbCounter').textContent = (curIdx + 1) + ' / ' + curGroup.length;\n  }\n\n  Object.keys(products).forEach(function (tab) {\n    var grid = document.getElementById('grid-' + tab);\n    if (!grid) return;\n    var imgs = products[tab].map(function (p) { return p.img; });\n    products[tab].forEach(function (p, i) {\n      var card = document.createElement('div');\n      card.className = 'pw-card';\n      card.innerHTML =\n        '<div class=\"pw-card-img-wrap\">' +\n          '<img class=\"pw-card-img\" src=\"' + BASE + p.img + '\" alt=\"Bảng giá ' + p.name + ' THE UNI\" loading=\"lazy\">' +\n        '</div>' +\n        '<div class=\"pw-card-body\">' +\n          '<div class=\"pw-card-name\">' + p.name + '</div>' +\n          '<div class=\"pw-card-hint\">Nhấn để xem bảng giá →</div>' +\n        '</div>';\n      card.addEventListener('click', function () { openLb(imgs, i); });\n      grid.appendChild(card);\n    });\n  });\n\n  document.querySelectorAll('.pw-tab').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      document.querySelectorAll('.pw-tab').forEach(function (b) { b.classList.remove('active'); });\n      document.querySelectorAll('.pw-section').forEach(function (s) { s.classList.remove('active'); });\n      btn.classList.add('active');\n      var t = document.getElementById('tab-' + btn.dataset.tab);\n      if (t) t.classList.add('active');\n    });\n  });\n\n  document.getElementById('lbClose').addEventListener('click', closeLb);\n  document.getElementById('pwLightbox').addEventListener('click', function (e) {\n    if (e.target === this) closeLb();\n  });\n  document.getElementById('lbPrev').addEventListener('click', function (e) {\n    e.stopPropagation();\n    curIdx = (curIdx - 1 + curGroup.length) % curGroup.length;\n    renderLb();\n  });\n  document.getElementById('lbNext').addEventListener('click', function (e) {\n    e.stopPropagation();\n    curIdx = (curIdx + 1) % curGroup.length;\n    renderLb();\n  });\n  document.addEventListener('keydown', function (e) {\n    if (!document.getElementById('pwLightbox').classList.contains('open')) return;\n    if (e.key === 'Escape')     closeLb();\n    if (e.key === 'ArrowLeft')  { curIdx = (curIdx - 1 + curGroup.length) % curGroup.length; renderLb(); }\n    if (e.key === 'ArrowRight') { curIdx = (curIdx + 1) % curGroup.length; renderLb(); }\n  });\n})();\n</script>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style=\"font-size:16px;margin-top: 15px;display: block;\">\n\t\t\t\t\t\t\t\t<p dir=\"ltr\" style=\"text-align: justify; margin-bottom: 5px;\"><strong>Thông tin liên hệ:</strong></p>\n\t\t\t\t\t\t\t\t<ul style=\"padding-left: 20px;\" dir=\"ltr\">\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Fanpage: <a style=\"color: #f4bd24;font-weight: 700;\" href=\"https://www.facebook.com/Shop.THEUNI.Clothing\" target=\"_blank\">THE UNI</a></li>\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Hotline: 028 6683 0386 - 039 9259 155</li>\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Email: theuniclothes@gmai.com&nbsp; |&nbsp; Liên hệ hợp tác: marketing@THEUNI.clothing</li>\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Cửa hàng: K249/83/4 Hà Huy Tập, Đà Nẵng (kiệt ô tô)</li>\n\t\t\t\t\t\t\t\t\t<li role=\"presentation\">Xưởng Sản xuất: 32 Lê Đình Cẩn, P. Bình Trị Đông A, Q. Bình Tân, TP.HCM</li></ul>\n\t\t\t\t\t\t\t</div>\n\n\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t</div>\n\n\t\t\t\t</div>\t\t\t\t\n\t\t\t"}