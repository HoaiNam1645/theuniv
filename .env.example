# Copy sang .env rồi điền giá trị thật. File .env KHÔNG được commit.

# MongoDB Atlas — connection string phải có TÊN DATABASE (/theuniv) và query param,
# thiếu tên database thì Prisma báo "database name is required".
# Dùng database RIÊNG cho máy dev (vd .../theuniv_dev) — đừng trỏ vào DB của
# máy chủ, mọi lần chạy thử sẽ ghi vào dữ liệu thật của khách.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/theuniv?retryWrites=true&w=majority"

# Khoá ký JWT phiên đăng nhập admin (cookie theuniv_session). Bắt buộc đổi khi lên production.
AUTH_SECRET="doi-chuoi-nay-o-production"

# Thư mục lưu ảnh upload. Bỏ trống -> ./public/uploads (dev). Production: /var/www/theuniv/uploads (nginx serve).
# UPLOAD_DIR="/var/www/theuniv/uploads"

# Mật khẩu admin khi chạy `npm run seed`. Bỏ trống -> seed tự sinh chuỗi ngẫu nhiên rồi in ra console.
# SEED_ADMIN_PASSWORD=""
